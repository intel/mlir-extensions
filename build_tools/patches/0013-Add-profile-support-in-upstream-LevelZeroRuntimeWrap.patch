+// Cache flush for profiling (IMEX_ENABLE_CACHE_FLUSHING=1).
+//
+// Before each timed run the profiler evicts the L3 (global memory cache) so
+// every run starts from the same, cold, state. The flush is a zero fill of a
+// device scratch buffer FOUR times the L3 size, and the host waits for it
+// before the timed kernel is launched.
+//
+// Why 4x: measured with a working set that fits in the L3, a fill had to be
+// about 2.5 to 3 times the L3 size before that working set was fully evicted;
+// smaller fills left part of it cached. 4x leaves margin, and matches the 4x
+// rule oneDNN's benchdnn uses for its GPU cold cache.
+struct CacheFlusher {
+  size_t cacheSize = 0;
+  void *scratch = nullptr;
+  bool enabled = false;
+
+  void init() {
+    if (!getenv("IMEX_ENABLE_CACHE_FLUSHING"))
+      return;
+    cacheSize = getGlobalMemoryCacheSize(getRtContext().device);
+    if (cacheSize == 0) {
+      std::cerr << "IMEX_ENABLE_CACHE_FLUSHING: device reports no global memory "
+                   "cache size; flushing disabled\n";
+      return;
+    }
+    scratch = allocDeviceMemory(4 * cacheSize, 64, false);
+    enabled = true;
+  }
+
+  void flush() {
+    if (!enabled)
+      return;
+    uint8_t val = 0;
+    L0_SAFE_CALL(zeCommandListAppendMemoryFill(
+        getRtContext().immCmdListCopy.get(), scratch, &val, sizeof(val),
+        4 * cacheSize, nullptr, 0, nullptr));
+    L0_SAFE_CALL(zeCommandListHostSynchronize(
+        getRtContext().immCmdListCopy.get(),
+        std::numeric_limits<uint64_t>::max()));
+  }
+
+  void destroy() {
+    if (scratch)
+      L0_SAFE_CALL(zeMemFree(getRtContext().context.get(), scratch));
+    scratch = nullptr;
+    enabled = false;
+  }
+};
+
